# ---------------- 运行模式 ----------------
# local = 进程内启动一条 London 硬分叉的本地 EVM 链（与武汉链同为以太坊内核），无需任何账号即可体验
# bsn   = 连接 BSN 武汉链（开放联盟链门户 / BSN-DDC 平台方网关）
CHAIN_MODE=local
PORT=8787

# ---------------- BSN 武汉链（CHAIN_MODE=bsn 时必填） ----------------
# RPC = 网关地址/api/<项目ID>/rpc ，见 BSN 文档 7.3.3 武汉链网关接入说明
CHAIN_RPC_URL=
# 武汉链 Chain ID 官方文档为 5555
CHAIN_ID=5555
# 若项目启用了项目 key，网关要求请求头 x-api-key
BSN_PROJECT_KEY=
# 平台链账户私钥（发布公钥模式 / 上传链账户地址模式下由我们自己签名）。只放在部署平台的 Secret 中！
PLATFORM_PRIVATE_KEY=
# 已部署的合约地址；留空则启动时自动部署（会消耗能量值）
REGISTRY_ADDRESS=
PASS_ADDRESS=
# 武汉链 SDK 默认 gasPrice 为 1 gwei，使用 legacy 交易
GAS_PRICE_WEI=1000000000
EXPLORER_TX_URL=https://wuhanexplorer.bsnbase.com/

# ---------------- 其他 ----------------
# 玩家/商家托管链账户派生盐（演示用；正式环境请改用 KMS/HSM 托管）
CUSTODY_SALT=change-me
# 游戏服务器调用 /api/game/events 时的 HMAC 密钥（留空 = 演示模式，不校验签名）
GAME_HMAC_SECRET=
# BSN 模式下的数据文件目录（local 模式数据随进程重置）
DATA_DIR=./data
